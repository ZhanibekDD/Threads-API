# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Threads (Meta) ---
THREADS_APP_ID=
THREADS_APP_SECRET=
# THREADS_ACCESS_TOKEN is only a manual/CLI bootstrap fallback now — once you
# connect via the review panel (/threads/connect), the DB-stored OAuth token
# takes priority. See docs/META_APP_REVIEW.md.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_API_VERSION=v1.0
# Must exactly match a Valid OAuth Redirect URI configured in the Meta App
# Dashboard, e.g. https://your-domain/threads/callback (or
# http://127.0.0.1:5000/threads/callback for local testing).
THREADS_REDIRECT_URI=

# 1 = threads_basic + threads_keyword_search + threads_content_publish only.
# 2 = stage 1 + threads_manage_replies (needed to publish a reply to someone
# else's post). See docs/META_APP_REVIEW.md for why this is staged.
OAUTH_STAGE=1

# --- Telegram (optional manual-review bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Business info ---
SITE_URL=https://zakonexpertt.kz/
WHATSAPP_NUMBER=77752998738

# --- Database ---
DATABASE_PATH=./data/threds.db

# --- Safety / limits ---
DRY_RUN=true
# NOTE: publishing a reply ALWAYS requires an explicit human confirmation
# (Telegram button or `python -m app.main approve <id>`). There is no
# unattended auto-publish loop in this codebase by design.
MANUAL_REVIEW_MIN_SCORE=70
AUTO_PUBLISH_MIN_SCORE=90
DAILY_REPLY_LIMIT=20
AUTHOR_COOLDOWN_DAYS=30
POST_MAX_AGE_HOURS=12
SEARCH_INTERVAL_MINUTES=60
AUTO_PUBLISH_OWN_CONTENT=false
# Comma-separated HH:MM, interpreted in OWN_CONTENT_TIMEZONE. Only publishes
# rows a human has already approved (`approve-content <id>`) — see
# app/content_generator.py publish_next_approved().
OWN_CONTENT_PUBLISH_TIMES=10:00,18:00
OWN_CONTENT_TIMEZONE=Asia/Almaty

# --- Review panel (python -m app.main run-web) ---
# Random long value for signing session/flash cookies — generate with
# `python -c "import secrets; print(secrets.token_hex(32))"`. If left empty,
# a random key is generated per-process (flash messages just won't survive
# a restart) — fine for local use, set a real one before deploying.
REVIEW_PANEL_SECRET_KEY=
# If left empty, the panel has NO login (fine for 127.0.0.1-only use). Set
# both before exposing the panel beyond localhost.
REVIEW_PANEL_USERNAME=admin
REVIEW_PANEL_PASSWORD=
REVIEW_PANEL_PORT=5000
# 127.0.0.1 for bare-metal `python -m app.main run-web`. docker-compose.yml
# overrides this to 0.0.0.0 for the containerized service automatically.
REVIEW_PANEL_HOST=127.0.0.1
